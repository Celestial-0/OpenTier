  "query": "\n        SELECT id, user_id, expires_at,\n               ip_address::TEXT as \"ip_address?\", user_agent, created_at\n        FROM sessions\n        WHERE user_id = $1 AND expires_at > NOW()\n        ORDER BY created_at DESC\n        ",
