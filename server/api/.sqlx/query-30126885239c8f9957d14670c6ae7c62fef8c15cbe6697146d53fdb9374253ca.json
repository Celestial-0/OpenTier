{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            ks.id,\n            ks.contributor_id,\n            u.email as contributor_email,\n            u.name as contributor_name,\n            ks.title,\n            ks.content,\n            ks.resource_type,\n            ks.metadata,\n            ks.status,\n            ks.admin_feedback,\n            ks.reviewed_by,\n            ks.reviewed_at,\n            ks.created_at,\n            ks.updated_at\n        FROM knowledge_submissions ks\n        JOIN users u ON u.id = ks.contributor_id\n        WHERE ks.status = $1\n        ORDER BY ks.created_at DESC\n        LIMIT $2 OFFSET $3\n        ",
