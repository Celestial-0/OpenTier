# ============================================
# Docker Image Registry (GHCR)
# ============================================
IMAGE_REPO_OWNER=celestial-0
IMAGE_TAG=latest

# ============================================
# Database (PostgreSQL 18)
# ============================================
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=opentier

# Internal Docker network connection string (or external when deployed outside Docker)
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@database:5432/${POSTGRES_DB}

# ============================================
# Redis (cache, locks, rate limits, event streams)
# ============================================
REDIS_URL=redis://redis:6379/0

# ============================================
# Qdrant (vector database)
# ============================================
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

# ============================================
# Secrets Encryption
# ============================================
# AES-256-GCM master key sealing provider API keys stored in Postgres.
# Generate with: openssl rand -base64 32
ENCRYPTION_MASTER_KEY=

# ============================================
# Intelligence Service — Build Args
# ============================================
# CPU-only deployment (default for VPS / cloud without GPU)
INTELLIGENCE_BASE_IMAGE=debian:bookworm-slim
INTELLIGENCE_UV_ARGS=""

# For GPU deployments with CUDA support:
# INTELLIGENCE_BASE_IMAGE=pytorch/pytorch:2.10.0-cuda13.0-cudnn9-runtime
# INTELLIGENCE_UV_ARGS=""

# ============================================
# API — Server
# ============================================
SERVER_PORT=4000
RUST_LOG=api=info,tower_http=info
AUTO_MIGRATE=true

# ============================================
# API — OAuth: Google
# ============================================
GOOGLE_OAUTH_ENABLE=true
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URL=https://your-domain.com/v1/auth/oauth/google/callback

# ============================================
# API — OAuth: GitHub
# ============================================
GITHUB_OAUTH_ENABLE=true
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URL=https://your-domain.com/v1/auth/oauth/github/callback

# ============================================
# API — OAuth: Microsoft
# ============================================
MICROSOFT_OAUTH_ENABLE=true
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
MICROSOFT_REDIRECT_URL=https://your-domain.com/v1/auth/oauth/microsoft/callback

# ============================================
# API — OAuth: Discord
# ============================================
DISCORD_OAUTH_ENABLE=true
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret
DISCORD_REDIRECT_URL=https://your-domain.com/v1/auth/oauth/discord/callback

# ============================================
# API — OAuth: X (Twitter)
# ============================================
X_OAUTH_ENABLE=false
X_CLIENT_ID=your-x-client-id
X_CLIENT_SECRET=your-x-client-secret
X_REDIRECT_URL=https://your-domain.com/v1/auth/oauth/x/callback

# ============================================
# API — Email (SMTP)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
FROM_EMAIL=noreply@yourdomain.com
CONTACT_EMAIL=contact@yourdomain.com

# ============================================
# API — Application URLs
# ============================================
FRONTEND_URL=https://your-frontend-domain.com
API_URL=https://your-api-domain.com

# ============================================
# API — Security & Session
# ============================================
SESSION_EXPIRY_SECONDS=2592000
VERIFICATION_TOKEN_EXPIRY_SECONDS=86400
PASSWORD_RESET_TOKEN_EXPIRY_SECONDS=3600

# ============================================
# API — CORS
# ============================================
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com

# ============================================
# API — Rate Limiting
# ============================================
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# ============================================
# API — Usage Quota / Free Tier
# ============================================
USAGE_LIMITS_ENABLED=true

# ============================================
# API — Credit Billing
# ============================================
CREDITS_ENFORCED=false
CREDIT_RESERVE_ESTIMATE=5.0

# ============================================
# Worker (durable background consumers)
# ============================================
WORKER_ROLE=all

# ============================================
# Intelligence — Runtime
# ============================================
ENVIRONMENT=production
LOG_LEVEL=INFO
GRPC_PORT=50051

# ============================================
# Intelligence — DB Pool
# ============================================
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600
DB_ECHO=false

# ============================================
# Intelligence — Ingestion
# ============================================
INGESTION_CHUNK_SIZE=512
INGESTION_CHUNK_OVERLAP=50
INGESTION_MAX_BATCH_SIZE=100
INGESTION_AUTO_CLEAN=true
INGESTION_GENERATE_EMBEDDINGS=true
INGESTION_MAX_CONTENT_LENGTH=1000000
INGESTION_CLEANING_STRATEGY=standard

# ============================================
# Intelligence — Scraping
# ============================================
SCRAPING_TIMEOUT=30
SCRAPING_MAX_RETRIES=3
SCRAPING_USER_AGENT="OpenTier Intelligence Bot/1.0"

# ============================================
# AI Models & Providers (Database Managed)
# ============================================
# All LLM and Embedding models (e.g. Gemini 3.5 Flash Lite, Gemini Embedding 2)
# and their provider configurations (API keys, base URLs, fallback chains) are
# managed dynamically via PostgreSQL (`model_providers` and `models` tables).
# Provider credentials/API keys are sealed at rest using ENCRYPTION_MASTER_KEY.
# Manage providers, models, and fallback chains via the Admin Dashboard (/dashboard).
