# ============================================
# Database (PostgreSQL / pgvector)
# ============================================
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=opentier


DATABASE_URL=postgres://
DB_URL=postgresql://
# ============================================
# Intelligence Service — Build Args
# ============================================
# For GPU deployments (default): leave commented out
# For CPU-only deployments (e.g. AWS without GPU):
# INTELLIGENCE_BASE_IMAGE=debian:bookworm-slim
# INTELLIGENCE_UV_ARGS="--extra cpu"

# ============================================
# API — Server
# ============================================
SERVER_PORT=4000
# Log level: trace, debug, info, warn, error
RUST_LOG=api=info,tower_http=info

# ============================================
# API — OAuth: Google
# ============================================
GOOGLE_OAUTH_ENABLE=true
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URL=https://your-domain.com/auth/oauth/google/callback

# ============================================
# API — OAuth: GitHub
# ============================================
GITHUB_OAUTH_ENABLE=true
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URL=https://your-domain.com/auth/oauth/github/callback

# ============================================
# API — OAuth: Microsoft
# ============================================
MICROSOFT_OAUTH_ENABLE=true
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
MICROSOFT_REDIRECT_URL=https://your-domain.com/auth/oauth/microsoft/callback

# ============================================
# API — OAuth: Discord
# ============================================
DISCORD_OAUTH_ENABLE=true
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret
DISCORD_REDIRECT_URL=https://your-domain.com/auth/oauth/discord/callback

# ============================================
# API — OAuth: X (Twitter)
# ============================================
# In X Developer Portal, enable "Request email from users" for this app.
# OAuth scopes used by backend: tweet.read users.read users.email offline.access
X_OAUTH_ENABLE=false
X_CLIENT_ID=your-x-client-id
X_CLIENT_SECRET=your-x-client-secret
X_REDIRECT_URL=https://your-domain.com/auth/oauth/x/callback

X_CONSUMEER_KEY=your-x-consumer-key
X_SECRET_KEY=your-x-secret-key
X_BEARER_TOKEN=your-x-bearer-token

# ============================================
# API — Email (SMTP)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
FROM_EMAIL=noreply@yourdomain.com
CONTACT_EMAIL=contact@yourdomain.com

# ============================================
# API — Application URLs
# ============================================
FRONTEND_URL=https://your-frontend-domain.com
API_URL=https://your-api-domain.com

# ============================================
# API — Security & Session
# ============================================
SESSION_EXPIRY_SECONDS=2592000
VERIFICATION_TOKEN_EXPIRY_SECONDS=86400
PASSWORD_RESET_TOKEN_EXPIRY_SECONDS=3600

# ============================================
# API — CORS
# ============================================
# Comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com

# ============================================
# API — Rate Limiting
# ============================================
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# ============================================
# API — Usage Quota / Free Tier
# ============================================
# Set to false to disable all message quotas (e.g. self-hosted / local deployments).
# When true: anonymous IPs get 5 free messages; authenticated users get message_limit (default 10).
USAGE_LIMITS_ENABLED=true

# ============================================
# Intelligence — Runtime
# ============================================
ENVIRONMENT=production
LOG_LEVEL=INFO
GRPC_PORT=50051

# ============================================
# Intelligence — DB Pool
# ============================================
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600
DB_ECHO=false

# ============================================
# Intelligence — Ingestion
# ============================================
INGESTION_CHUNK_SIZE=512
INGESTION_CHUNK_OVERLAP=50
INGESTION_MAX_BATCH_SIZE=100
INGESTION_AUTO_CLEAN=true
INGESTION_GENERATE_EMBEDDINGS=true
INGESTION_MAX_CONTENT_LENGTH=1000000
INGESTION_CLEANING_STRATEGY=standard

# ============================================
# Intelligence — Embeddings
# ============================================
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384
EMBEDDING_BATCH_SIZE=32

# ============================================
# Intelligence — Scraping
# ============================================
SCRAPING_TIMEOUT=30
SCRAPING_MAX_RETRIES=3
SCRAPING_USER_AGENT="OpenTier Intelligence Bot/1.0"

# ============================================
# Intelligence — LLM
# ============================================
# Google Gemini (default)
LLM_PROVIDER=google
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=your-google-ai-api-key
LLM_MODEL=gemini-2.5-flash-lite
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=10000
# OpenAI alternative:
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-your-openai-key
# LLM_MODEL=gpt-4o
# Local Ollama alternative (free):
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=llama3.2:latest
